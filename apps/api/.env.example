# Copia este archivo a `apps/api/.env` y ajusta lo que necesites.
# `.env` esta en .gitignore: nunca se versiona.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# ADR 0001: dos roles distintos, a proposito.
#   ets_owner   emite DDL (Prisma sobre public, materializador sobre proj_*)
#   app_runtime solo DML (CRUD de las aplicaciones generadas)
# Los crea docker/postgres/init/01-roles.sql al levantar el contenedor.
DATABASE_URL=postgres://ets_owner:ets_local_password@localhost:5432/ets
DATABASE_URL_RUNTIME=postgres://app_runtime:ets_runtime_password@localhost:5432/ets

# Better Auth. Genera el secreto con:  openssl rand -hex 32
#
# AUTH_BASE_URL es el origen PUBLICO, el que ve el navegador, y no el puerto de
# esta API: el panel de Next reescribe /api/* hacia aqui, asi que para el
# navegador todo ocurre en su propio origen.
#
# AUTH_TRUSTED_ORIGINS tiene que contener ese mismo origen. Better Auth exige
# una cabecera `Origin` valida en las peticiones que cambian estado —es su
# proteccion contra CSRF—, y si el origen del panel no figura aqui, cerrar
# sesion responde 403.
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3100
AUTH_TRUSTED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Necesaria desde F3 (motor de inferencia). Obligatoria si NODE_ENV=production.
ANTHROPIC_API_KEY=

# Almacenamiento de los xlsx subidos (F2). Nunca se sirve estaticamente.
STORAGE_DIR=./storage

# Cuotas por persona (F8).
MAX_PROJECTS_PER_USER=50
MAX_ANALYSES_PER_HOUR=20
MAX_UPLOADS_PER_HOUR=60

# Limites de ingesta (F2).
MAX_UPLOAD_BYTES=20971520
MAX_SHEET_ROWS=200000
MAX_SHEETS=50
MAX_UNCOMPRESSED_BYTES=314572800
MAX_SHEET_COLUMNS=256
